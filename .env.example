ONE_ENV=development
# Leave unset for local SQLite. Compose defaults to its PostgreSQL service;
# set this explicitly only when overriding the deployment database endpoint.
# ONE_DATABASE_URL=postgresql://one:replace-with-a-local-postgres-password@postgres:5432/one
ONE_OBJECT_STORE_PATH=./data/objects
# Compose-only dependency credentials; replace before any shared LAN use.
ONE_POSTGRES_DB=one
ONE_POSTGRES_USER=one
ONE_POSTGRES_PASSWORD=replace-with-a-local-postgres-password
ONE_MINIO_ROOT_USER=one-local
ONE_MINIO_ROOT_PASSWORD=replace-with-a-local-minio-password
# Generate with: python -c 'import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())'
ONE_CLIP_ENCRYPTION_KEY_B64=
# Required before enabling live biometric enrollment. Generate a separate
# 32-byte key; never reuse the clip key. Without it, face profiles remain
# unavailable and no embeddings are written.
ONE_BIOMETRIC_ENCRYPTION_KEY_B64=
ONE_BOOTSTRAP_SECRET=change-me-in-production
ONE_SESSION_TTL_MINUTES=10080
ONE_LIVEKIT_URL=ws://localhost:7880
# For remote/Tailscale clients, set this to an IP they can reach (for example
# this host's Tailscale IPv4). LiveKit uses it in WebRTC ICE candidates.
# ONE_LIVEKIT_NODE_IP=100.84.223.26
# Matches the local `livekit-server --dev` container. Change both together
# only when using a controlled LAN/Tailscale endpoint.
ONE_LIVEKIT_API_KEY=devkey
ONE_LIVEKIT_API_SECRET=secret
ONE_LM_STUDIO_URL=http://127.0.0.1:1234/v1
ONE_LM_STUDIO_MODEL=qwen3.6-35b-a3b
ONE_LM_STUDIO_API_KEY=
# Camera localization must use the host-side MPS/CUDA worker. Docker Desktop
# cannot expose Apple Metal/MPS to a Linux container, so do not route this
# calibration path to the CPU-only Compose worker.
ONE_GEOMETRY_SERVICE_URL=http://host.docker.internal:8090
ONE_GEOMETRY_TIMEOUT_SECONDS=45
ONE_GEOMETRY_LOCALIZATION_STALL_TIMEOUT_SECONDS=180
ONE_GEOMETRY_REQUIRE_GPU=true
# Real local model: YOLOv8-World v2 detects indoor furniture, doors, windows,
# and structural classes from the temporary RGB sweep. The checkpoint is not
# committed; download it to a private local model directory and point to it.
ONE_GEOMETRY_MODE=model
ONE_GEOMETRY_MODEL_PATH=/absolute/path/to/yolov8s-worldv2.pt
ONE_GEOMETRY_MODEL_CONFIG=/absolute/path/to/one/geometry_service/model_config.yolo-world.json
# Optional local face models. The Compose worker stays healthy without these
# files, but face enrollment and identity matching report unavailable until
# both are present. Download them with scripts/download_face_models.sh.
ONE_FACE_MODELS_PATH=./data/face-models
ONE_FACE_DETECTOR_MODEL_PATH=/absolute/path/to/face-models/face_detection_yunet_2023mar.onnx
ONE_FACE_RECOGNIZER_MODEL_PATH=/absolute/path/to/face-models/face_recognition_sface_2021dec.onnx
ONE_GEOMETRY_DEVICE=auto
ONE_GEOMETRY_SOLVER_DEVICE=auto
ONE_GEOMETRY_ALLOW_CPU=false
# Compose-only runtime controls. Docker Desktop cannot expose Apple MPS to a
# Linux container, so the managed worker defaults to CPU.
ONE_GEOMETRY_DOCKER_DEVICE=cpu
ONE_GEOMETRY_DOCKER_ALLOW_CPU=true
ONE_POSITIONING_WORKERS=3
# Alias also accepted for existing local inference setups:
# LLM_API_KEY=
# Optional OpenAI-compatible override (for example OpenRouter or another
# compatible gateway). Leave ONE_LLM_ENABLED=false for deterministic fallback
# operation without making any LLM request.
# ONE_LLM_ENABLED=true
# ONE_LLM_PROVIDER=openrouter
# ONE_LLM_BASE_URL=https://openrouter.ai/api/v1
# ONE_LLM_MODEL=provider/model-name
# ONE_LLM_API_KEY=
# ONE_LLM_TIMEOUT_SECONDS=15
ONE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173,http://localhost:4174,http://localhost:4175,http://127.0.0.1:5173,http://127.0.0.1:4173,http://127.0.0.1:4174,http://127.0.0.1:4175
# Frontend host binding. Keep loopback for the secure default; use 0.0.0.0
# only for a trusted same-LAN test. Tailscale Serve works with loopback.
ONE_FRONTEND_BIND=127.0.0.1
# Fresh Docker website port. 4175 is an independent existing checkout.
ONE_FRONTEND_PORT=4175
# Caddy is loopback-only by default; expose the frontend through Tailscale Serve.
ONE_CADDY_HTTPS_PORT=8443
ONE_CADDY_HTTP_PORT=8080
